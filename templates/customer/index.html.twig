
{% extends 'admin/base.html.twig' %}

{% block title %}Customer Management | RideGo{% endblock %}

{% block body %}

{# ================= PAGE HEADER ================= #}

<div class="page-header">
    <div>
        <h1>Customer Management</h1>
        <p>Manage your motorcycle rental customers.</p>
    </div>

    <button type="button"
            class="add-btn"
            style="border: none; cursor: pointer;"
            data-bs-toggle="modal"
            data-bs-target="#addCustomerModal">
        + Add Customer
    </button>
</div>


{# ================= ADD CUSTOMER MODAL ================= #}

<div class="modal fade"
     id="addCustomerModal"
     tabindex="-1"
     aria-labelledby="addCustomerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addCustomerModalLabel">
                    Add Customer
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            {{ form_start(form) }}

            <div class="modal-body">

                {{ form_errors(form) }}

                <div class="mb-3">
                    {{ form_label(form.name, 'Customer Name') }}
                    {{ form_widget(form.name, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.email, 'Email Address') }}
                    {{ form_widget(form.email, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.phoneNumber, 'Phone Number') }}
                    {{ form_widget(form.phoneNumber, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(form.phoneNumber) }}
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn"
                        style="background-color: #3C9995; color: white; border: none;">
                    Save Customer
                </button>
            </div>

            {{ form_rest(form) }}
            {{ form_end(form, {'render_rest': false}) }}

        </div>
    </div>
</div>


{# ================= EDIT CUSTOMER MODALS ================= #}

{% for customer in customers %}

<div class="modal fade"
     id="editCustomerModal{{ customer.id }}"
     tabindex="-1"
     aria-labelledby="editCustomerModalLabel{{ customer.id }}"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="editCustomerModalLabel{{ customer.id }}">
                    Edit Customer
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            {{ form_start(editForms[customer.id]) }}

            <div class="modal-body">

                {{ form_errors(editForms[customer.id]) }}

                <div class="mb-3">
                    {{ form_label(
                        editForms[customer.id].name,
                        'Customer Name'
                    ) }}

                    {{ form_widget(
                        editForms[customer.id].name,
                        {'attr': {'class': 'form-control'}}
                    ) }}

                    {{ form_errors(editForms[customer.id].name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(
                        editForms[customer.id].email,
                        'Email Address'
                    ) }}

                    {{ form_widget(
                        editForms[customer.id].email,
                        {'attr': {'class': 'form-control'}}
                    ) }}

                    {{ form_errors(editForms[customer.id].email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(
                        editForms[customer.id].phoneNumber,
                        'Phone Number'
                    ) }}

                    {{ form_widget(
                        editForms[customer.id].phoneNumber,
                        {'attr': {'class': 'form-control'}}
                    ) }}

                    {{ form_errors(editForms[customer.id].phoneNumber) }}
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn"
                        style="background-color: #3C9995; color: white; border: none;">
                    Save Changes
                </button>
            </div>

            {{ form_rest(editForms[customer.id]) }}
            {{ form_end(editForms[customer.id], {'render_rest': false}) }}

        </div>
    </div>
</div>

{% endfor %}


{# ================= CUSTOMER TABLE ================= #}

<div class="table-container">

    <table class="table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Customer Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        {% for customer in customers %}

            <tr>
                <td>{{ customer.id }}</td>
                <td>{{ customer.name }}</td>
                <td>{{ customer.email }}</td>
                <td>{{ customer.phoneNumber }}</td>

                <td>
                    <div class="actions">

                        {# EDIT BUTTON #}

                        <button type="button"
                                class="edit-btn"
                                style="border: none; cursor: pointer;"
                                data-bs-toggle="modal"
                                data-bs-target="#editCustomerModal{{ customer.id }}">
                            Edit
                        </button>


                        {# DELETE FORM #}

                        <form method="post"
                              action="{{ path('app_customer_delete', {'id': customer.id}) }}"
                              id="customer-delete-form-{{ customer.id }}"
                              style="display: inline-block; margin: 0;">

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('delete' ~ customer.id) }}">

                            <button type="button"
                                    class="delete-btn"
                                    style="border: none; cursor: pointer;"
                                    data-customer-id="{{ customer.id }}"
                                    data-customer-name="{{ customer.name|e('html_attr') }}"
                                    onclick="openCustomerDeleteModal(this.dataset.customerId, this.dataset.customerName)">
                                Delete
                            </button>

                        </form>

                    </div>
                </td>
            </tr>

        {% else %}

            <tr>
                <td colspan="5" class="text-center">
                    No customers found.
                </td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

</div>


{# ================= DELETE CUSTOMER MODAL ================= #}

<div id="customerDeleteModal" class="modal-overlay">

    <div class="delete-modal">

        <h2>Delete Customer?</h2>

        <p id="customerDeleteMessage">
            Are you sure you want to delete this customer?
        </p>

        <div class="modal-actions">

            <button type="button"
                    class="cancel-delete-btn"
                    onclick="closeCustomerDeleteModal()">
                Cancel
            </button>

            <button type="button"
                    class="confirm-delete-btn"
                    onclick="confirmCustomerDelete()">
                Delete
            </button>

        </div>

    </div>

</div>


{# ================= JAVASCRIPT ================= #}

<script>
    let customerDeleteId = null;

    function openCustomerDeleteModal(id, name) {
        customerDeleteId = id;

        document.getElementById('customerDeleteMessage').textContent =
            'Are you sure you want to delete ' + name + '?';

        document.getElementById('customerDeleteModal').style.display = 'flex';
    }

    function closeCustomerDeleteModal() {
        document.getElementById('customerDeleteModal').style.display = 'none';
        customerDeleteId = null;
    }

    function confirmCustomerDelete() {
        if (customerDeleteId !== null) {
            const deleteForm = document.getElementById(
                'customer-delete-form-' + customerDeleteId
            );

            if (deleteForm) {
                deleteForm.submit();
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {

        // Reopen Add Customer popup when validation fails
        {% if openAddCustomerModal is defined and openAddCustomerModal %}

            const addModalElement = document.getElementById(
                'addCustomerModal'
            );

            if (addModalElement && typeof bootstrap !== 'undefined') {
                const addModal = new bootstrap.Modal(addModalElement);
                addModal.show();
            }

        {% endif %}

        // Reopen Edit Customer popup when validation fails
        {% if openEditCustomerId is defined %}

            const editModalElement = document.getElementById(
                'editCustomerModal{{ openEditCustomerId }}'
            );

            if (editModalElement && typeof bootstrap !== 'undefined') {
                const editModal = new bootstrap.Modal(editModalElement);
                editModal.show();
            }

        {% endif %}

    });
</script>

{% endblock %}
