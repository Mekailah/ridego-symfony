
{% extends 'base.html.twig' %}

{% block title %}Admin Login | RideGo{% endblock %}

{% block body %}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        min-height: 100vh;
        background: linear-gradient(135deg, #0b1730 0%, #142e4b 60%, #126e79 100%);
    }

    .ridego-login-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
        box-sizing: border-box;
    }

    .ridego-login-card {
        background: #ffffff;
        width: 100%;
        max-width: 430px;
        border-radius: 16px;
        padding: 40px 36px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    }

    .ridego-brand {
        text-align: center;
        margin-bottom: 32px;
    }

    .ridego-logo {
        font-family: 'Poppins', 'Arial', sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: #102b46;
        letter-spacing: -1px;
        line-height: 1.2;
    }

    .ridego-logo span {
        color: #0c9ca4;
    }

    .ridego-subtitle {
        font-family: 'Arial', sans-serif;
        color: #718096;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 3px;
        margin-top: 12px;
    }

    .ridego-login-title {
        font-size: 21px;
        font-weight: 700;
        color: #152b43;
        margin-bottom: 24px;
        text-align: center;
    }

    .ridego-form-group {
        margin-bottom: 20px;
    }

    .ridego-form-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #34465b;
        margin-bottom: 8px;
    }

    .ridego-form-control {
        display: block;
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #d6dfe8;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
        background: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .ridego-form-control:focus {
        outline: none;
        border-color: #0c9ca4;
        box-shadow: 0 0 0 3px rgba(12, 156, 164, 0.12);
    }

    .ridego-login-button {
        width: 100%;
        padding: 14px;
        background: #0c8e99;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.2s;
    }

    .ridego-login-button:hover {
        background: #08747e;
    }

    .ridego-login-error {
        padding: 12px 14px;
        background: #fff0f0;
        border: 1px solid #f2b5b5;
        border-radius: 8px;
        color: #b42318;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .ridego-login-footer {
        margin-top: 28px;
        text-align: center;
        color: #8995a4;
        font-size: 12px;
    }

    @media (max-width: 480px) {
        .ridego-login-card {
            padding: 30px 22px;
        }
    }


    /* Password visibility toggle */
    .ridego-password-wrapper {
        position: relative;
    }

    .ridego-password-wrapper .ridego-form-control {
        padding-right: 52px;
    }

    .ridego-password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: #718096;
        cursor: pointer;
        padding: 6px;
    }

    .ridego-password-toggle:hover {
        color: #0c8e99;
    }

    .ridego-password-toggle:focus-visible {
        outline: 2px solid #0c9ca4;
        border-radius: 4px;
    }

</style>

<div class="ridego-login-wrapper">
    <div class="ridego-login-card">

        <div class="ridego-brand">
            <div class="ridego-logo">RIDE<span>GO</span></div>
            <div class="ridego-subtitle">DRIVE YOUR JOURNEY</div>
        </div>

        <h1 class="ridego-login-title">Login</h1>

        {% if error %}
            <div class="ridego-login-error" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

            <form method="post" action="{{ path('app_login') }}">

                <div class="ridego-form-group">
                    <label for="username" class="ridego-form-label">
                        Email or Username
                    </label>

                    <input
                        type="text"
                        name="_username"
                        id="username"
                        class="ridego-form-control"
                        value="{{ last_username }}"
                        placeholder="Enter your email or username"
                        autocomplete="username"
                        required
                        autofocus
                    >
                </div>

                <div class="ridego-form-group">
                    <label for="password" class="ridego-form-label">
                        Password
                    </label>

                    
                <div class="ridego-password-wrapper">
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="ridego-form-control"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                    <button
                        type="button"
                        class="ridego-password-toggle"
                        onclick="toggleLoginPassword()"
                        aria-label="Show password"
                        aria-pressed="false"
                        id="loginPasswordToggle">

                        <svg id="loginEyeIcon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>

                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button type="submit" class="ridego-login-button">
                    Sign In
                </button>

            </form>

        <div class="ridego-login-footer">
            &copy; {{ "now"|date("Y") }} RideGo. Authorized personnel only.
        </div>

    </div>
</div>


<script>
    function toggleLoginPassword() {
        const passwordInput = document.getElementById('password');
        const toggleButton = document.getElementById('loginPasswordToggle');
        const eyeIcon = document.getElementById('loginEyeIcon');

        const isHidden = passwordInput.type === 'password';

        passwordInput.type = isHidden ? 'text' : 'password';

        toggleButton.setAttribute(
            'aria-label',
            isHidden ? 'Hide password' : 'Show password'
        );

        toggleButton.setAttribute(
            'aria-pressed',
            isHidden ? 'true' : 'false'
        );

        if (isHidden) {
            eyeIcon.innerHTML = `
                <path d="M3 3l18 18"/>
                <path d="M10.6 5.1A11 11 0 0 1 12 5c6.5 0 10 7 10 7a16 16 0 0 1-3.1 3.8"/>
                <path d="M6.2 6.2C3.5 8 2 12 2 12s3.5 7 10 7a10.5 10.5 0 0 0 4.1-.8"/>
                <path d="M10 10a3 3 0 0 0 4 4"/>
            `;
        } else {
            eyeIcon.innerHTML = `
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                <circle cx="12" cy="12" r="3"/>
            `;
        }
    }
</script>


{% endblock %}
