
{% extends 'admin/base.html.twig' %}

{% block title %}User Management | RideGo{% endblock %}

{% block body %}

{# ========== SUCCESS NOTIFICATION ========== #}

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show user-alert"
         role="alert">
        {{ message }}

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
{% endfor %}

{# ========== ERROR NOTIFICATION ========== #}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show user-alert"
         role="alert">
        {{ message }}

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
{% endfor %}

{# ================= PAGE HEADER ================= #}

<div class="page-header">
    <div>
        <h1>User Management</h1>
        <p>View and manage registered Admin and Staff accounts.</p>
    </div>
</div>

{# ================= USER TABLE ================= #}

<div class="table-container">
    <table class="users-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.fullName ?: '—' }}</td>
                    <td>{{ user.username ?: '—' }}</td>
                    <td>{{ user.email }}</td>

                    <td>
                        {% if 'ROLE_ADMIN' in user.roles %}
                            Admin
                        {% elseif 'ROLE_STAFF' in user.roles %}
                            Staff
                        {% else %}
                            User
                        {% endif %}
                    </td>

                    <td>
                        {% if user.isActive %}
                            <span style="color: #198754; font-weight: 600;">
                                Active
                            </span>
                        {% else %}
                            <span style="color: #dc3545; font-weight: 600;">
                                Disabled
                            </span>
                        {% endif %}
                    </td>

                    <td>
                        <div class="actions">

                            {# EDIT USER BUTTON #}

                            <button type="button"
                                    class="edit-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editUserModal{{ user.id }}">
                                Edit
                            </button>

                            {% if app.user.id != user.id %}

                                {# RESET PASSWORD BUTTON #}

                                <button type="button"
                                        class="user-reset-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPasswordModal{{ user.id }}">
                                    Reset Password
                                </button>

                                {# DELETE USER BUTTON #}

                                <button type="button"
                                        class="user-delete-btn"
                                        onclick="openUserDeleteModal({{ user.id }})">
                                    Delete
                                </button>

                            {% endif %}

                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align: center;">
                        No registered users found.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# ================= EDIT USER MODALS ================= #}

{% for user in users %}

<div class="modal fade"
     id="editUserModal{{ user.id }}"
     tabindex="-1"
     aria-labelledby="editUserModalLabel{{ user.id }}"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="editUserModalLabel{{ user.id }}">
                    Edit User
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            {{ form_start(editForms[user.id]) }}

            <div class="modal-body">

                {{ form_errors(editForms[user.id]) }}

                <div class="mb-3">
                    {{ form_label(editForms[user.id].fullName) }}
                    {{ form_widget(editForms[user.id].fullName, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(editForms[user.id].fullName) }}
                </div>

                <div class="mb-3">
                    {{ form_label(editForms[user.id].username) }}
                    {{ form_widget(editForms[user.id].username, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(editForms[user.id].username) }}
                </div>

                <div class="mb-3">
                    {{ form_label(editForms[user.id].email) }}
                    {{ form_widget(editForms[user.id].email, {
                        'attr': {'class': 'form-control'}
                    }) }}
                    {{ form_errors(editForms[user.id].email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(editForms[user.id].isActive) }}
                    {{ form_widget(editForms[user.id].isActive, {
                        'attr': {'class': 'form-select'}
                    }) }}
                    {{ form_errors(editForms[user.id].isActive) }}
                </div>

                <div class="mb-3">
                    {{ form_label(editForms[user.id].roles) }}
                    {{ form_widget(editForms[user.id].roles, {
                        'attr': {'class': 'form-select'}
                    }) }}
                    {{ form_errors(editForms[user.id].roles) }}
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn"
                        style="background-color: #3C9995; color: white;">
                    Save Changes
                </button>

            </div>

            {{ form_widget(editForms[user.id]._token) }}
            {{ form_end(editForms[user.id], {'render_rest': false}) }}

        </div>
    </div>
</div>

{% endfor %}

{# ================= RESET PASSWORD MODALS ================= #}

{% for user in users %}

    {% if app.user.id != user.id %}

        <div class="modal fade"
             id="resetPasswordModal{{ user.id }}"
             tabindex="-1"
             aria-labelledby="resetPasswordModalLabel{{ user.id }}"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="resetPasswordModalLabel{{ user.id }}">
                            Reset Password
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <form method="post"
                          action="{{ path('admin_users_reset_password', {id: user.id}) }}"
                          class="reset-password-form"
                          data-fullname="{{ user.fullName ?: user.username ?: user.email }}">

                        <div class="modal-body">

                            <p class="reset-password-description">
                                Set a new password for
                                <strong>{{ user.fullName ?: user.username ?: user.email }}</strong>
                            </p>

                            <div class="mb-3">

                                <label for="newPassword{{ user.id }}"
                                       class="form-label">
                                    New Password
                                </label>

                                <div class="password-input-wrapper">

                                    <input type="password"
                                           id="newPassword{{ user.id }}"
                                           name="new_password"
                                           class="form-control"
                                           minlength="12"
                                           autocomplete="new-password"
                                           placeholder="Enter new password"
                                           required>

                                    <button type="button"
                                            class="password-toggle-btn"
                                            aria-label="Show new password"
                                            aria-pressed="false"
                                            onclick="toggleResetPassword('newPassword{{ user.id }}', this)">

                                        <svg class="eye-icon"
                                             width="20"
                                             height="20"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>

                                    </button>

                                </div>

                                <small class="text-muted">
                                    Password must contain at least 12 characters.
                                </small>

                            </div>

                            <div class="mb-3">

                                <label for="confirmPassword{{ user.id }}"
                                       class="form-label">
                                    Confirm New Password
                                </label>

                                <div class="password-input-wrapper">

                                    <input type="password"
                                           id="confirmPassword{{ user.id }}"
                                           name="confirm_password"
                                           class="form-control"
                                           minlength="12"
                                           autocomplete="new-password"
                                           placeholder="Confirm new password"
                                           required>

                                    <button type="button"
                                            class="password-toggle-btn"
                                            aria-label="Show confirmed password"
                                            aria-pressed="false"
                                            onclick="toggleResetPassword('confirmPassword{{ user.id }}', this)">

                                        <svg class="eye-icon"
                                             width="20"
                                             height="20"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>

                                    </button>

                                </div>

                                <div class="invalid-feedback password-match-error">
                                    New passwords do not match.
                                </div>

                            </div>

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('reset_password_' ~ user.id) }}">

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn user-confirm-reset-btn">
                                Reset Password
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>

    {% endif %}

{% endfor %}

{# ========== RESET PASSWORD CONFIRMATION MODAL ========== #}

<div class="modal fade"
     id="confirmResetModal"
     tabindex="-1"
     aria-labelledby="confirmResetModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"
             style="border-radius: 14px; border: none;">

            <div class="modal-body text-center p-4">

                <div style="
                    width: 65px;
                    height: 65px;
                    border-radius: 50%;
                    background: #d1fae5;
                    color: #3c9995;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 0 auto 20px;
                    font-size: 30px;">
                    &#8635;
                </div>

                <h4 id="confirmResetModalLabel"
                    style="font-weight: 700; color: #102033;">
                    Confirm Password Reset
                </h4>

                <p class="mt-3" style="color: #6b7280;">
                    Are you sure you want to reset the password for
                    <strong id="confirmResetName"
                            style="color: #102033;"></strong>?
                </p>

                <p style="color: #6b7280; font-size: 14px;">
                    The user will need to use their new password
                    the next time they log in.
                </p>

                <div class="d-flex justify-content-center gap-3 mt-4">

                    <button type="button"
                            class="btn btn-secondary px-4"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="confirmResetButton"
                            class="btn px-4"
                            style="background: #3c9995; color: white;">
                        Yes, Reset Password
                    </button>

                </div>

            </div>
        </div>
    </div>
</div>

{# ================= DELETE USER MODALS ================= #}

{% for user in users %}

    {% if app.user.id != user.id %}

        <div id="user-delete-modal-{{ user.id }}"
             class="user-modal-overlay"
             hidden>

            <div class="user-modal-box"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="user-delete-title-{{ user.id }}">

                <h2 id="user-delete-title-{{ user.id }}">
                    Delete User?
                </h2>

                <p>
                    Are you sure you want to delete
                    {{ user.username ?: user.email }}?
                </p>

                <div class="user-modal-actions">

                    <button type="button"
                            class="user-cancel-btn"
                            onclick="closeUserDeleteModal({{ user.id }})">
                        Cancel
                    </button>

                    <form method="post"
                          action="{{ path('admin_users_delete', {id: user.id}) }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete_user_' ~ user.id) }}">

                        <button type="submit"
                                class="user-confirm-delete-btn">
                            Delete
                        </button>

                    </form>

                </div>
            </div>
        </div>

    {% endif %}

{% endfor %}

{# ================= CSS ================= #}

<style>

    /* USER TABLE */

    .users-table {
        table-layout: fixed;
        width: 100%;
    }

    .users-table th:nth-child(1) { width: 5%; }
    .users-table th:nth-child(2) { width: 15%; }
    .users-table th:nth-child(3) { width: 13%; }
    .users-table th:nth-child(4) { width: 22%; }
    .users-table th:nth-child(5) { width: 9%; }
    .users-table th:nth-child(6) { width: 9%; }
    .users-table th:nth-child(7) { width: 27%; }

    .users-table td {
        overflow-wrap: anywhere;
    }

    /* ACTION BUTTONS */

    .table-container .edit-btn,
    .table-container .user-reset-btn,
    .table-container .user-delete-btn {
        display: inline-block;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 400;
        line-height: normal;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        margin: 0;
    }

    .table-container .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .table-container .edit-btn {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .table-container .edit-btn:hover {
        background: #bfdbfe;
    }

    .table-container .user-reset-btn {
        background: #d1fae5;
        color: #047857;
    }

    .table-container .user-reset-btn:hover {
        background: #a7f3d0;
    }

    .table-container .user-delete-btn {
        background: #fee2e2;
        color: #b91c1c;
    }

    .table-container .user-delete-btn:hover {
        background: #fecaca;
    }

    /* RESET PASSWORD MODAL */

    .reset-password-description {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 22px;
        line-height: 1.5;
    }

    .reset-password-description strong {
        color: #102033;
    }

    .password-input-wrapper {
        position: relative;
    }

    .password-input-wrapper .form-control {
        padding-right: 48px;
    }

    .password-toggle-btn {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: none;
        background: transparent;
        color: #667085;
        cursor: pointer;
        border-radius: 6px;
    }

    .password-toggle-btn:hover {
        background: #f3f4f6;
        color: #102033;
    }

    .password-toggle-btn:focus-visible {
        outline: 2px solid #3c9995;
        outline-offset: 2px;
    }

    .user-confirm-reset-btn {
        background: #3c9995;
        color: white;
        border: none;
    }

    .user-confirm-reset-btn:hover {
        background: #307f7b;
        color: white;
    }

    /* DELETE MODAL OVERLAY */

    .user-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .user-modal-overlay[hidden] {
        display: none;
    }

    /* DELETE MODAL BOX */

    .user-modal-box {
        background: white;
        width: 420px;
        max-width: 90%;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .user-modal-box h2 {
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 10px;
        color: #111827;
    }

    .user-modal-box p {
        font-size: 15px;
        color: #6b7280;
        line-height: 1.5;
        margin: 0 0 25px;
    }

    /* DELETE MODAL ACTION BUTTONS */

    .user-modal-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
    }

    .user-modal-actions form {
        margin: 0;
    }

    .user-cancel-btn,
    .user-confirm-delete-btn {
        border: none;
        padding: 10px 17px;
        border-radius: 7px;
        cursor: pointer;
        font-size: 14px;
        font-weight: bold;
    }

    .user-cancel-btn {
        background: #e5e7eb;
        color: #374151;
    }

    .user-confirm-delete-btn {
        background: #dc2626;
        color: white;
    }

    .user-cancel-btn:hover {
        background: #d1d5db;
    }

    .user-confirm-delete-btn:hover {
        background: #b91c1c;
    }


    /* CONFIRM PASSWORD RESET MODAL */

    #confirmResetModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 15px 45px rgba(16, 32, 51, 0.15);
    }

    #confirmResetModal .modal-body {
        padding: 35px !important;
    }

    #confirmResetModal #confirmResetModalLabel {
        font-size: 23px;
        font-weight: 700;
        color: #102033;
    }

    #confirmResetModal #confirmResetName {
        color: #102033;
        font-weight: 700;
    }

    #confirmResetModal #confirmResetButton {
        background-color: #3c9995;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 18px;
    }

    #confirmResetModal #confirmResetButton:hover {
        background-color: #307f7b;
    }

    #confirmResetModal .btn-secondary {
        background-color: #e5e7eb;
        border: none;
        color: #374151;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 18px;
    }

</style>

{# ================= JAVASCRIPT ================= #}

<script>

    /* DELETE USER MODAL */

    function openUserDeleteModal(id) {
        document.getElementById(
            'user-delete-modal-' + id
        ).hidden = false;
    }

    function closeUserDeleteModal(id) {
        document.getElementById(
            'user-delete-modal-' + id
        ).hidden = true;
    }

    /* SHOW / HIDE PASSWORD */

    function toggleResetPassword(inputId, button) {
        const input = document.getElementById(inputId);

        if (!input) {
            return;
        }

        const isVisible = input.type === 'password';

        input.type = isVisible ? 'text' : 'password';

        button.setAttribute(
            'aria-label',
            isVisible ? 'Hide password' : 'Show password'
        );

        button.setAttribute(
            'aria-pressed',
            isVisible ? 'true' : 'false'
        );

        const svg = button.querySelector('svg');

        if (svg) {
            svg.innerHTML = isVisible
                ? '<path d="M3 3l18 18"></path><path d="M10.6 5.1A11.2 11.2 0 0 1 12 5c6.5 0 10 7 10 7a15.5 15.5 0 0 1-3.2 4.1"></path><path d="M6.1 6.1C3.5 8.1 2 12 2 12s3.5 7 10 7a10.7 10.7 0 0 0 5.4-1.5"></path><path d="M10 10a3 3 0 0 0 4 4"></path>'
                : '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>';
        }
    }

    /* RESET PASSWORD VALIDATION AND CONFIRMATION */

    document.addEventListener('DOMContentLoaded', function () {

        document.querySelectorAll('.reset-password-form').forEach(function (form) {

            const newPassword = form.querySelector(
                'input[name="new_password"]'
            );

            const confirmPassword = form.querySelector(
                'input[name="confirm_password"]'
            );

            const mismatchError = form.querySelector(
                '.password-match-error'
            );

            function validatePasswords() {

                if (
                    confirmPassword.value !== '' &&
                    newPassword.value !== confirmPassword.value
                ) {
                    confirmPassword.classList.add('is-invalid');
                    mismatchError.style.display = 'block';
                    return false;
                }

                confirmPassword.classList.remove('is-invalid');
                mismatchError.style.display = 'none';
                return true;
            }

            newPassword.addEventListener('input', validatePasswords);
            confirmPassword.addEventListener('input', validatePasswords);

            form.addEventListener('submit', function (event) {

                if (!validatePasswords()) {
                    event.preventDefault();
                    confirmPassword.focus();
                    return;
                }

                
                event.preventDefault();

                const resetModalElement = form.closest('.modal');
                const resetModal = bootstrap.Modal.getOrCreateInstance(
                    resetModalElement
                );

                const confirmModalElement = document.getElementById(
                    'confirmResetModal'
                );

                const confirmationModal = bootstrap.Modal.getOrCreateInstance(
                    confirmModalElement
                );

                document.getElementById('confirmResetName').textContent =
                    form.dataset.fullname;

                document.getElementById('confirmResetButton').onclick = function () {
                    this.disabled = true;
                    this.textContent = 'Resetting...';
                    form.submit();
                };

                // Wait for the first modal to finish closing.
                resetModalElement.addEventListener('hidden.bs.modal', function () {
                    confirmationModal.show();
                }, { once: true });

                resetModal.hide();


            });

        });

        /* AUTO DISMISS SUCCESS / ERROR ALERTS */

        document.querySelectorAll('.user-alert').forEach(function (alert) {

            setTimeout(function () {

                if (typeof bootstrap !== 'undefined') {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }

            }, 3000);

        });

    });

</script>

{% endblock %}
