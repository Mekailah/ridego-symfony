<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied | RideGo</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #F5F7F9;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .error-card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border-radius: 14px;
            padding: 42px 32px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(14, 27, 42, 0.08);
        }

        .error-code {
            font-size: 64px;
            font-weight: bold;
            color: #0E1B2A;
            margin-bottom: 12px;
        }

        h1 {
            font-size: 25px;
            color: #0E1B2A;
            margin-bottom: 14px;
        }

        p {
            font-size: 15px;
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .back-btn {
            display: inline-block;
            padding: 12px 24px;
            background: #3C9995;
            color: white;
            border-radius: 7px;
            text-decoration: none;
            font-weight: bold;
        }

        .back-btn:hover {
            background: #307F7C;
        }
    </style>
</head>
<body>

    <div class="error-card">
        <div class="error-code">403</div>

        <h1>Access Denied</h1>

        <p>
            You don't have permission to access this page.
            Please return to an authorized section of RideGo.
        </p>

        <a href="{{ is_granted('ROLE_ADMIN') ? path('admin_dashboard') : path('admin_motorcycles') }}"
           class="back-btn">
            Back to RideGo
        </a>
    </div>

</body>
</html>