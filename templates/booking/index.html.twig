{% extends 'admin/base.html.twig' %}

{% block title %}Bookings | RideGo{% endblock %}

{% block body %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show booking-alert" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

{# ================= PAGE HEADER ================= #}

<div class="page-header">
    <div>
        <h1>Booking Management</h1>
        <p>Manage motorcycle bookings and returns.</p>
    </div>

    <button
        type="button"
        class="add-btn"
        data-bs-toggle="modal"
        data-bs-target="#addBookingModal">
        + Add Booking
    </button>
</div>

{# ================= ADD BOOKING MODAL ================= #}

<div class="modal fade"
     id="addBookingModal"
     tabindex="-1"
     aria-labelledby="addBookingModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addBookingModalLabel">
                    Add Booking
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>
            </div>

            {{ form_start(form) }}

                <div class="modal-body">

                    {# CUSTOMER #}

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            {{ form_label(form.customer, 'Customer', {
                                'label_attr': {'class': 'mb-0'}
                            }) }}

                            <a href="{{ path('app_customer_new') }}"
                               class="btn btn-sm"
                               style="border: 1px solid #3C9995; color: #3C9995;">
                                + Add New Customer
                            </a>
                        </div>

                        {{ form_widget(form.customer, {
                            'attr': {'class': 'form-select'}
                        }) }}

                        {{ form_errors(form.customer) }}
                    </div>

                    {# CUSTOMER CONTACT DETAILS #}

                    <div id="bookingCustomerDetails"
                         class="border rounded p-3 mb-3"
                         style="display: none; background-color: #f8f9fa;">

                        <div class="mb-3">
                            <label for="bookingCustomerEmail" class="form-label">
                                Email
                            </label>

                            <input
                                type="email"
                                id="bookingCustomerEmail"
                                class="form-control"
                                readonly>
                        </div>

                        <div>
                            <label for="bookingCustomerPhone" class="form-label">
                                Phone Number
                            </label>

                            <input
                                type="text"
                                id="bookingCustomerPhone"
                                class="form-control"
                                readonly>
                        </div>
                    </div>

                    {# MOTORCYCLE #}

                    <div class="mb-3">
                        {{ form_label(form.motorcycleName, 'Motorcycle') }}

                        {{ form_widget(form.motorcycleName, {
                            'attr': {'class': 'form-select'}
                        }) }}

                        {{ form_errors(form.motorcycleName) }}
                    </div>

                    {# PICK-UP DATE #}

                    <div class="mb-3">
                        {{ form_label(form.pickupDate, 'Pick-up Date') }}

                        {{ form_widget(form.pickupDate, {
                            'attr': {'class': 'form-control'}
                        }) }}

                        {{ form_errors(form.pickupDate) }}
                    </div>

                    {# RETURN DATE #}

                    <div class="mb-3">
                        {{ form_label(form.returnDate, 'Return Date') }}

                        {{ form_widget(form.returnDate, {
                            'attr': {'class': 'form-control'}
                        }) }}

                        {{ form_errors(form.returnDate) }}
                    </div>

                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn"
                        style="background-color: #3C9995; color: white; border: none;">
                        Save Booking
                    </button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>

{# ================= BOOKINGS TABLE ================= #}

<div class="booking-table-scroll">
    <table>
        <colgroup>
            <col style="width: 132px;">
            <col style="width: 160px;">
            <col span="8">
        </colgroup>
        <thead>
            <tr>
                <th>Booking ID</th>
                <th>Customer</th>
                <th>Motorcycle</th>
                <th>Pick-up Date</th>
                <th>Return Date</th>
                <th>Total Amount</th>
                <th>Payment Status</th>
                <th>Status</th>
                <th>Returned</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
        
        {% for booking in bookings %}
            <tr data-return-token="{{ csrf_token('return' ~ booking.id) }}">

                <td>#{{ booking.id }}</td>
                <td>{{ booking.customerName }}</td>
                <td>{{ booking.motorcycleName }}</td>

                <td>{{ booking.pickupDate|date('M d, Y') }}</td>
                <td>{{ booking.returnDate|date('M d, Y') }}</td>

                <td>
                    {% if booking.totalAmount is not null %}
                        ₱{{ booking.totalAmount|number_format(2, '.', ',') }}
                    {% else %}
                        —
                    {% endif %}
                </td>

                {# PAYMENT STATUS #}

                <td>
                    {% set isPaid = false %}

                    {% for payment in booking.payments %}
                        {% if payment.paymentStatus == 'Paid' %}
                            {% set isPaid = true %}
                        {% endif %}
                    {% endfor %}

                    {% if isPaid %}
                        <span class="badge bg-success">Paid</span>
                    {% else %}
                        <span class="badge bg-warning text-dark">Unpaid</span>
                    {% endif %}
                </td>

                {# BOOKING STATUS #}

                <td>
                    {% if booking.status == 'Pending' %}
                        <span class="status pending">Pending</span>
                    {% elseif booking.status == 'Confirmed' %}
                        <span class="status confirmed">Confirmed</span>
                    {% elseif booking.status == 'Returned' %}
                        <span class="status available">Returned</span>
                    {% else %}
                        {{ booking.status }}
                    {% endif %}
                </td>

                <td>
                    {% if booking.returned %}
                        Yes
                    {% else %}
                        No
                    {% endif %}
                </td>

                {# ACTIONS #}

                <td>
                    {% if booking.status == 'Pending' %}

                        <div class="booking-actions">

                            <form
                                method="post"
                                action="{{ path('admin_booking_confirm', {'id': booking.id}) }}"
                                >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('confirm' ~ booking.id) }}">

                                <button type="submit" class="confirm-btn">
                                    Confirm
                                </button>
                            </form>

                            <form
                                method="post"
                                action="{{ path('admin_booking_delete', {'id': booking.id}) }}"
                                id="booking-delete-form-{{ booking.id }}"
                                >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete' ~ booking.id) }}">

                                <button
                                    type="button"
                                    class="delete-btn"
                                    style="border: none; cursor: pointer;"
                                    onclick="openBookingDeleteModal({{ booking.id }})">
                                    Delete
                                </button>
                            </form>
                        </div>

                    {% elseif booking.status == 'Confirmed' and not booking.returned %}

                        <form
                            method="post"
                            action="{{ path('admin_booking_return', {'id': booking.id}) }}"
                            style="margin: 0;">

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('return' ~ booking.id) }}">

                            <button type="submit" class="return-btn">
                                Mark as Returned
                            </button>
                        </form>

                    {% elseif booking.returned %}

                        <span class="status available">Returned</span>

                    {% endif %}
                </td>
            </tr>

        {% else %}
            <tr>
                <td colspan="10">No bookings found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# ================= DELETE BOOKING MODAL ================= #}

<div id="bookingDeleteModal" class="modal-overlay">
    <div class="delete-modal">

        <h2>Delete Booking?</h2>

        <p>Are you sure you want to delete this booking?</p>

        <div class="modal-actions">
            <button
                type="button"
                class="cancel-delete-btn"
                onclick="closeBookingDeleteModal()">
                Cancel
            </button>

            <button
                type="button"
                class="confirm-delete-btn"
                onclick="confirmBookingDelete()">
                Delete
            </button>
        </div>

    </div>
</div>

{# ================= JAVASCRIPT ================= #}


<script>
    let bookingDeleteId = null;

    // Open Delete Booking confirmation modal
    function openBookingDeleteModal(id) {
        bookingDeleteId = id;

        document.getElementById('bookingDeleteModal').style.display = 'flex';
    }

    // Close Delete Booking confirmation modal
    function closeBookingDeleteModal() {
        document.getElementById('bookingDeleteModal').style.display = 'none';
        bookingDeleteId = null;
    }

    // Delete booking after confirmation
    function confirmBookingDelete() {
        if (bookingDeleteId !== null) {
            const deleteForm = document.getElementById(
                'booking-delete-form-' + bookingDeleteId
            );

            if (deleteForm) {
                deleteForm.submit();
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {

        // Customer information for Add Booking modal
        const customers = {{ customerDetails|json_encode|raw }};

        const customerSelect = document.getElementById(
            '{{ form.customer.vars.id }}'
        );

        const customerDetails = document.getElementById(
            'bookingCustomerDetails'
        );

        const customerEmail = document.getElementById(
            'bookingCustomerEmail'
        );

        const customerPhone = document.getElementById(
            'bookingCustomerPhone'
        );

        function updateCustomerDetails() {
            if (!customerSelect) {
                return;
            }

            const selectedCustomer = customers[customerSelect.value];

            if (selectedCustomer) {
                customerEmail.value = selectedCustomer.email || '';
                customerPhone.value = selectedCustomer.phone || '';
                customerDetails.style.display = 'block';
            } else {
                customerEmail.value = '';
                customerPhone.value = '';
                customerDetails.style.display = 'none';
            }
        }

        if (customerSelect) {
            customerSelect.addEventListener(
                'change',
                updateCustomerDetails
            );

            updateCustomerDetails();
        }

        // Automatically close error notifications
        document.querySelectorAll('.booking-alert').forEach(
            function (alertElement) {
                setTimeout(function () {
                    if (typeof bootstrap !== 'undefined') {
                        bootstrap.Alert.getOrCreateInstance(
                            alertElement
                        ).close();
                    }
                }, 3000);
            }
        );

        // Confirm and Mark as Returned use normal HTML form submissions.
        // No AJAX, JSON parsing, or success popups.

    });
</script>


<style>
    /* Add Booking modal: scroll the fields, keep Save/Cancel visible. */
    #addBookingModal .modal-dialog,
    #addBookingModal .modal-content {
        max-height: calc(100dvh - 2rem);
    }

    #addBookingModal .modal-content,
    #addBookingModal .modal-content > form {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    #addBookingModal .modal-content > form {
        flex: 1 1 auto;
    }

    #addBookingModal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    #addBookingModal .modal-header,
    #addBookingModal .modal-footer {
        flex-shrink: 0;
    }

    #addBookingModal .modal-footer {
        background: #fff;
    }

    /* One scrolling container, without padding that offsets sticky columns. */
    .booking-table-scroll {
        width: 100%;
        overflow-x: auto;
        background: #fff;
        border-radius: 16px;
        -webkit-overflow-scrolling: touch;
    }

    .booking-table-scroll table {
        width: 100%;
        min-width: 1370px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .booking-table-scroll th,
    .booking-table-scroll td {
        padding: 18px 14px;
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }

    .booking-table-scroll th {
        color: #667085;
        font-weight: 600;
    }

    .booking-table-scroll tbody tr:last-child td {
        border-bottom: 0;
    }

    /* The colgroup and sticky offsets must use the same widths. */
    .booking-table-scroll th:nth-child(1),
    .booking-table-scroll td:nth-child(1) {
        position: sticky;
        left: 0;
        z-index: 2;
        width: 132px;
        min-width: 132px;
        max-width: 132px;
    }

    .booking-table-scroll th:nth-child(2),
    .booking-table-scroll td:nth-child(2) {
        position: sticky;
        left: 132px;
        z-index: 2;
        width: 160px;
        min-width: 160px;
        max-width: 160px;
        border-right: 1px solid #e5e7eb;
        box-shadow: 4px 0 6px rgba(0, 0, 0, 0.05);
    }

    .booking-table-scroll thead th:nth-child(-n+2) {
        z-index: 3;
    }

    .booking-table-scroll .booking-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .booking-table-scroll .booking-actions form {
        margin: 0;
    }
</style>

{% endblock %}