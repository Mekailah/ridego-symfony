{% extends 'admin/base.html.twig' %}

{% block title %}Edit Motorcycle | RideGo{% endblock %}

{% block body %}

<div class="page-header">
    <div>
        <h1>Edit Motorcycle</h1>
        <p>Update motorcycle details.</p>
    </div>
</div>

<div class="form-container">

    {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.name, 'Motorcycle Name') }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.pricePerDay, 'Price Per Day') }}
            {{ form_widget(form.pricePerDay) }}
            {{ form_errors(form.pricePerDay) }}
        </div>

        <div class="form-group">
            {{ form_label(form.totalUnits, 'Total Units') }}
            {{ form_widget(form.totalUnits) }}
            {{ form_errors(form.totalUnits) }}
        </div>

        <div class="form-group">
            {{ form_label(form.availableUnits, 'Available Units') }}
            {{ form_widget(form.availableUnits) }}
            {{ form_errors(form.availableUnits) }}
        </div>

        <div class="form-group">
            {{ form_label(form.image, 'Image') }}
            {{ form_widget(form.image) }}
            {{ form_errors(form.image) }}
        </div>

        <div class="form-actions">

            <a href="{{ path('admin_motorcycles') }}"
               class="cancel-btn">
                Cancel
            </a>

            <button type="submit" class="save-btn">
                Update Motorcycle
            </button>

        </div>

    {{ form_end(form) }}

</div>

{% endblock %}