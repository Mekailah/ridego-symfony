{% extends 'admin/base.html.twig' %}

{% block title %}Motorcycles | RideGo{% endblock %}

{% block body %}

<div class="page-header">
    <div>
        <h1>Motorcycle Management</h1>
        <p>Manage motorcycles available for rental.</p>
    </div>

    <a href="{{ path('admin_motorcycle_new') }}" class="add-btn">
        + Add Motorcycle
    </a>
</div>

<div class="table-container">

    <table>
        <thead>
            <tr>
                <th>Image</th>
                <th>Motorcycle</th>
                <th>Price / Day</th>
                <th>Total Units</th>
                <th>Available Units</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        {% for motorcycle in motorcycles %}

            <tr>
                <td>
                    <div class="motorcycle-image">
                        {% if motorcycle.image %}
                            {{ motorcycle.image }}
                        {% else %}
                            No Image
                        {% endif %}
                    </div>
                </td>

                <td>{{ motorcycle.name }}</td>

                <td>₱{{ motorcycle.pricePerDay }}.00</td>

                <td>{{ motorcycle.totalUnits }}</td>
                
                <td>{{ motorcycle.availableUnits }}</td>

                <td>
                    {% if motorcycle.availableUnits > 0 %}
                        <span class="status available">
                            Available
                        </span>
                    {% else %}
                        <span class="status unavailable">
                            Unavailable
                        </span>
                    {% endif %}
                </td>

                <td>
                    <div class="actions">

                        <a href="{{ path('admin_motorcycle_edit', {'id': motorcycle.id}) }}"
                        class="edit-btn">
                            Edit
                        </a>

                        <form
                            method="post"
                            action="{{ path('admin_motorcycle_delete', {'id': motorcycle.id}) }}"
                            id="delete-form-{{ motorcycle.id }}"
                            style="margin: 0;"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete' ~ motorcycle.id) }}"
                            >

                            <button
                                type="button"
                                class="delete-btn"
                                onclick="openDeleteModal({{ motorcycle.id }})">
                                Delete
                            </button>
                        </form>

                    </div>
                </td>
            </tr>

        {% else %}

            <tr>
                <td colspan="7">
                    No motorcycles found.
                </td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

</div>

<div id="deleteModal" class="modal-overlay">
    <div class="delete-modal">

        <h2>Delete Motorcycle?</h2>

        <p>
            Are you sure you want to delete this motorcycle?
        </p>

        <div class="modal-actions">
            <button
                type="button"
                class="cancel-delete-btn"
                onclick="closeDeleteModal()">
                Cancel
            </button>

            <button
                type="button"
                class="confirm-delete-btn"
                onclick="confirmDelete()">
                Delete
            </button>
        </div>

    </div>
</div>

<script>
    let deleteFormId = null;

    function openDeleteModal(id) {
        deleteFormId = id;
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        deleteFormId = null;
    }

    function confirmDelete() {
        if (deleteFormId !== null) {
            document
                .getElementById('delete-form-' + deleteFormId)
                .submit();
        }
    }
</script>

{% endblock %}