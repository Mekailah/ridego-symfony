
{% extends 'admin/base.html.twig' %}

{% block title %}Payment Management | RideGo{% endblock %}

{% block body %}

{# ========== SUCCESS NOTIFICATION ========== #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show payment-alert"
         role="alert">
        {{ message }}

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
{% endfor %}


{# ================= PAGE HEADER ================= #}

<div class="page-header">
    <div>
        <h1>Payment Management</h1>
        <p>Manage motorcycle rental payments.</p>
    </div>

</div>

{# ================= EDIT PAYMENT MODALS ================= #}

{% for payment in payments %}
    {% if editForms[payment.id] is defined %}   

<div
    class="modal fade"
    id="editPaymentModal{{ payment.id }}"
    tabindex="-1"
    aria-labelledby="editPaymentModalLabel{{ payment.id }}"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5
                    class="modal-title"
                    id="editPaymentModalLabel{{ payment.id }}"
                >
                    Edit Payment
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>

            {{ form_start(editForms[payment.id]) }}

            <div class="modal-body">
                {{ form_errors(editForms[payment.id]) }}

                <div class="mb-3">
                    {{ form_label(
                        editForms[payment.id].booking,
                        'Booking'
                    ) }}

                    <input
                        type="text"
                        class="form-control"
                        value="Booking #{{ payment.booking.id }} — {{ payment.booking.customerName }} — {{ payment.booking.motorcycleName }}"
                        readonly
                    >

                    {{ form_errors(editForms[payment.id].booking) }}
                    <div class="d-none">
                        {{ form_widget(editForms[payment.id].booking) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(
                        editForms[payment.id].amount,
                        'Amount (PHP)'
                    ) }}

                    {{ form_widget(
                        editForms[payment.id].amount,
                        {'attr': {'class': 'form-control'}}
                    ) }}

                    {{ form_errors(editForms[payment.id].amount) }}
                </div>

                <div class="mb-3">
                    {{ form_label(
                        editForms[payment.id].paymentMethod,
                        'Payment Method'
                    ) }}

                    {{ form_widget(
                        editForms[payment.id].paymentMethod,
                        {'attr': {'class': 'form-select'}}
                    ) }}

                    {{ form_errors(editForms[payment.id].paymentMethod) }}
                </div>

                <div class="mb-3">
                    {{ form_label(
                        editForms[payment.id].paymentStatus,
                        'Payment Status'
                    ) }}

                    {{ form_widget(
                        editForms[payment.id].paymentStatus,
                        {'attr': {'class': 'form-select'}}
                    ) }}

                    {{ form_errors(editForms[payment.id].paymentStatus) }}
                </div>
            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="btn"
                    style="background-color: #3C9995; color: white; border: none;"
                >
                    Save Changes
                </button>
            </div>

            {{ form_rest(editForms[payment.id]) }}
            {{ form_end(editForms[payment.id], {'render_rest': false}) }}

        </div>
    </div>
</div>
    {% endif %}
{% endfor %}


{# ================= PAYMENT TABLE ================= #}

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Booking</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
                <th>Payment Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
        {% for payment in payments %}
            <tr>
                <td>{{ payment.id }}</td>

                <td>#{{ payment.booking.id }}</td>

                <td>{{ payment.booking.customerName }}</td>

                <td>
                    ₱{{ payment.amount|number_format(2, '.', ',') }}
                </td>

                <td>{{ payment.paymentMethod ?? '—' }}</td>

                <td>
                    {% if payment.paymentStatus == 'Paid' %}
                        <span class="badge bg-success">Paid</span>

                    {% elseif payment.paymentStatus == 'Pending' %}
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>

                    {% elseif payment.paymentStatus == 'Failed' %}
                        <span class="badge bg-danger">Failed</span>

                    {% else %}
                        <span class="badge bg-secondary">
                            {{ payment.paymentStatus }}
                        </span>
                    {% endif %}
                </td>

                <td>
                    {% if payment.paymentDate %}
                        {{ payment.paymentDate|date('M d, Y h:i A') }}
                    {% else %}
                        —
                    {% endif %}
                </td>

                <td>

                {% if editForms[payment.id] is defined %}
                    <div class="actions">

                        {# ========== EDIT PAYMENT ========== #}

                        <button
                            type="button"
                            class="edit-btn"
                            style="border: none; cursor: pointer;"
                            data-bs-toggle="modal"
                            data-bs-target="#editPaymentModal{{ payment.id }}"
                        >
                            Edit
                        </button>

                        {# ========== DELETE PAYMENT ========== #}

                        <form
                            method="post"
                            action="{{ path('app_payment_delete', {'id': payment.id}) }}"
                            id="payment-delete-form-{{ payment.id }}"
                            style="display: inline-block; margin: 0;"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete' ~ payment.id) }}"
                            >

                            <button
                                type="button"
                                class="delete-btn"
                                style="border: none; cursor: pointer;"
                                data-payment-id="{{ payment.id }}"
                                onclick="openPaymentDeleteModal(this.dataset.paymentId)"
                            >
                                Delete
                            </button>
                        </form>

                    </div>

                {% else %}
                    <span class="text-muted small">View only</span>
                {% endif %}
                </td>
            </tr>

        {% else %}
            <tr>
                <td colspan="8" class="text-center">
                    No payments found.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>


{# ================= DELETE PAYMENT MODAL ================= #}

<div id="paymentDeleteModal" class="modal-overlay">
    <div class="delete-modal">

        <h2>Delete Payment?</h2>

        <p>
            Are you sure you want to delete this payment?
        </p>

        <div class="modal-actions">

            <button
                type="button"
                class="cancel-delete-btn"
                onclick="closePaymentDeleteModal()"
            >
                Cancel
            </button>

            <button
                type="button"
                class="confirm-delete-btn"
                onclick="confirmPaymentDelete()"
            >
                Delete
            </button>

        </div>
    </div>
</div>



{# ================= JAVASCRIPT ================= #}

<script>
    let paymentDeleteId = null;

    function openPaymentDeleteModal(id) {
        paymentDeleteId = id;

        document.getElementById('paymentDeleteModal').style.display = 'flex';
    }

    function closePaymentDeleteModal() {
        document.getElementById('paymentDeleteModal').style.display = 'none';
        paymentDeleteId = null;
    }

    function confirmPaymentDelete() {
        if (paymentDeleteId !== null) {
            const deleteForm = document.getElementById(
                'payment-delete-form-' + paymentDeleteId
            );

            if (deleteForm) {
                deleteForm.submit();
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {

        // ========== REOPEN EDIT MODAL ON VALIDATION ERROR ==========

        {% if openEditPaymentId is defined %}
            const editModalElement = document.getElementById(
                'editPaymentModal{{ openEditPaymentId }}'
            );

            if (editModalElement && typeof bootstrap !== 'undefined') {
                new bootstrap.Modal(editModalElement).show();
            }
        {% endif %}

    });
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.payment-alert').forEach(function (alert) {
        setTimeout(function () {
            bootstrap.Alert.getOrCreateInstance(alert).close();
        }, 3000);
    });
});
</script>

{% endblock %}
