
{% extends 'admin/base.html.twig' %}

{% block title %}Change Password | RideGo{% endblock %}

{% block body %}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .password-page {
        max-width: 650px;
    }

    .password-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .password-card .card-body {
        padding: 32px;
    }

    .password-section-title {
        font-size: 19px;
        font-weight: 600;
        color: #152b43;
        margin-bottom: 8px;
    }

    .password-section-description {
        font-size: 13px;
        color: #718096;
        margin-bottom: 28px;
    }

    .password-field {
        margin-bottom: 22px;
    }

    .password-field .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #34465b;
        margin-bottom: 8px;
    }

    .password-input-wrapper {
        position: relative;
    }

    .password-input-wrapper .form-control {
        width: 100%;
        padding: 12px 50px 12px 14px;
        border: 1px solid #d6dfe8;
        border-radius: 8px;
        font-size: 14px;
        background: #fff;
    }

    .password-input-wrapper .form-control:focus {
        border-color: #3C9995;
        box-shadow: 0 0 0 3px rgba(60, 153, 149, 0.12);
    }

    .password-eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: #718096;
        cursor: pointer;
        padding: 6px;
        font-size: 18px;
    }

    .password-eye-btn:hover {
        color: #3C9995;
    }

    .password-eye-btn:focus-visible {
        outline: 2px solid #3C9995;
        border-radius: 4px;
    }

    .password-hint {
        display: block;
        margin-top: 7px;
        font-size: 12px;
        color: #718096;
    }

    .password-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .password-submit-btn {
        background-color: #3C9995;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 7px;
        font-weight: 600;
    }

    .password-submit-btn:hover {
        background-color: #307F7C;
        color: #fff;
    }

    .password-back-btn {
        padding: 10px 20px;
        border-radius: 7px;
    }

    .password-alert {
        border-radius: 8px;
        margin-bottom: 18px;
    }

    @media (max-width: 480px) {
        .password-card .card-body {
            padding: 24px 18px;
        }

        .password-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .password-actions .btn {
            width: 100%;
        }
    }
</style>

{# PAGE HEADER #}
<div class="page-header">
    <div>
        <h1>Change Password</h1>
        <p>Update your account password securely.</p>
    </div>
</div>

<div class="password-page">

    {# SUCCESS NOTIFICATIONS #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show password-alert"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    {% endfor %}

    {# ERROR NOTIFICATIONS #}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show password-alert"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>
            {{ message }}

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    {% endfor %}

    {# PASSWORD CARD #}
    <div class="card password-card">
        <div class="card-body">

            <h5 class="password-section-title">
                <i class="bi bi-shield-lock me-2"></i>
                Password & Security
            </h5>

            <p class="password-section-description">
                Enter your current password and choose a secure new password.
            </p>

            <form id="changePasswordForm"
                  method="post"
                  action="{{ path('app_change_password') }}"
                  data-turbo="false">

                {# CSRF PROTECTION #}
                <input type="hidden"
                       name="_token"
                       value="{{ csrf_token('change_password') }}">

                {# CURRENT PASSWORD #}
                <div class="password-field">

                    <label for="current_password" class="form-label">
                        Current Password
                    </label>

                    <div class="password-input-wrapper">

                        <input type="password"
                               id="current_password"
                               name="current_password"
                               class="form-control"
                               placeholder="Enter your current password"
                               autocomplete="current-password"
                               required>

                        <button type="button"
                                class="password-eye-btn"
                                onclick="togglePasswordVisibility('current_password', this)"
                                aria-label="Show current password"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>
                        </button>

                    </div>
                </div>

                {# NEW PASSWORD #}
                <div class="password-field">

                    <label for="new_password" class="form-label">
                        New Password
                    </label>

                    <div class="password-input-wrapper">

                        <input type="password"
                               id="new_password"
                               name="new_password"
                               class="form-control"
                               placeholder="Enter your new password"
                               minlength="12"
                               autocomplete="new-password"
                               required>

                        <button type="button"
                                class="password-eye-btn"
                                onclick="togglePasswordVisibility('new_password', this)"
                                aria-label="Show new password"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <small class="password-hint">
                        <i class="bi bi-info-circle me-1"></i>
                        Password must contain at least 12 characters.
                    </small>

                </div>

                {# CONFIRM NEW PASSWORD #}
                <div class="password-field">

                    <label for="confirm_password" class="form-label">
                        Confirm New Password
                    </label>

                    <div class="password-input-wrapper">

                        <input type="password"
                               id="confirm_password"
                               name="confirm_password"
                               class="form-control"
                               placeholder="Re-enter your new password"
                               minlength="12"
                               autocomplete="new-password"
                               required>

                        <button type="button"
                                class="password-eye-btn"
                                onclick="togglePasswordVisibility('confirm_password', this)"
                                aria-label="Show confirmed password"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <small id="passwordMatchError"
                           class="text-danger d-none mt-2">
                        New passwords do not match.
                    </small>

                </div>

                {# ACTION BUTTONS #}
                <div class="password-actions">

                    <a href="{{ path('app_profile') }}"
                       class="btn btn-outline-secondary password-back-btn">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Profile
                    </a>

                    <button type="button"
                            class="btn password-submit-btn"
                            onclick="showPasswordConfirmation()">

                        <i class="bi bi-check-circle me-1"></i>
                        Update Password
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

{# CONFIRMATION MODAL #}
<div class="modal fade"
     id="confirmPasswordModal"
     tabindex="-1"
     aria-labelledby="confirmPasswordModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="confirmPasswordModalLabel">

                    <i class="bi bi-shield-check me-2"></i>
                    Confirm Password Change
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <p class="mb-0">
                    Are you sure you want to update your account password?
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn password-submit-btn"
                        onclick="submitPasswordChange()">

                    Yes, Update Password
                </button>

            </div>

        </div>
    </div>
</div>

<script>

    // SHOW / HIDE PASSWORD
    function togglePasswordVisibility(inputId, button) {
        const input = document.getElementById(inputId);
        const icon = button.querySelector('i');

        const isHidden = input.type === 'password';

        input.type = isHidden ? 'text' : 'password';

        icon.classList.toggle('bi-eye', !isHidden);
        icon.classList.toggle('bi-eye-slash', isHidden);

        button.setAttribute(
            'aria-pressed',
            isHidden ? 'true' : 'false'
        );

        button.setAttribute(
            'aria-label',
            isHidden ? 'Hide password' : 'Show password'
        );
    }


    // OPEN CONFIRMATION MODAL
    function showPasswordConfirmation() {
        const form = document.getElementById('changePasswordForm');

        if (!form.reportValidity()) {
            return;
        }

        const newPassword =
            document.getElementById('new_password').value;

        const confirmPassword =
            document.getElementById('confirm_password').value;

        const errorMessage =
            document.getElementById('passwordMatchError');

        if (newPassword !== confirmPassword) {
            errorMessage.classList.remove('d-none');
            return;
        }

        errorMessage.classList.add('d-none');

        const modal = bootstrap.Modal.getOrCreateInstance(
            document.getElementById('confirmPasswordModal')
        );

        modal.show();
    }


    // SUBMIT PASSWORD CHANGE
    function submitPasswordChange() {
        const form = document.getElementById('changePasswordForm');

        if (form.reportValidity()) {
            form.submit();
        }
    }


    // DISMISS NOTIFICATIONS AFTER 3 SECONDS
    document.addEventListener('DOMContentLoaded', function () {

        document.querySelectorAll('.password-alert').forEach(
            function (alertElement) {

                setTimeout(function () {

                    if (alertElement.isConnected) {
                        bootstrap.Alert.getOrCreateInstance(
                            alertElement
                        ).close();
                    }

                }, 3000);

            }
        );

    });

</script>

{% endblock %}
